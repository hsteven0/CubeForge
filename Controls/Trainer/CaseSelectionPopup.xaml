<UserControl x:Class="CubeForge.Controls.CaseSelectionPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="PopupScrollBarThumb" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border Background="#555555"
                                CornerRadius="4"
                                Opacity="0.75" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent"
                              Width="8">
                            <primitives:Track x:Name="PART_Track"
                                              IsDirectionReversed="True">
                                <primitives:Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  IsTabStop="False"
                                                  Command="ScrollBar.PageUpCommand" />
                                </primitives:Track.DecreaseRepeatButton>

                                <primitives:Track.Thumb>
                                    <primitives:Thumb Style="{StaticResource PopupScrollBarThumb}" />
                                </primitives:Track.Thumb>

                                <primitives:Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  IsTabStop="False"
                                                  Command="ScrollBar.PageDownCommand" />
                                </primitives:Track.IncreaseRepeatButton>
                            </primitives:Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0D0D0D"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12"
            Width="360"
            MaxHeight="430"
            ClipToBounds="False">

        <StackPanel>
            <TextBlock Text="Trainer Case Selection"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />

            <TextBlock x:Name="SummaryTextBlock"
                       Text="Choose which cases can appear in trainer mode."
                       Foreground="#AFAFAF"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <UniformGrid Columns="2"
                         Margin="0,0,0,12">
                <Button Content="Train all"
                        Click="OnTrainAllClicked"
                        Margin="0,0,5,6"
                        Padding="8" />

                <Button Content="Unknown only"
                        Click="OnTrainUnknownClicked"
                        Margin="5,0,0,6"
                        Padding="8" />

                <Button Content="Known only"
                        Click="OnTrainKnownClicked"
                        Margin="0,0,5,6"
                        Padding="8" />

                <Button Content="Clear"
                        Click="OnClearSelection"
                        Margin="5,0,0,6"
                        Padding="8" />
            </UniformGrid>

            <Button x:Name="EditCasesButton"
                    Content="Edit individual cases"
                    Click="OnEditCasesClicked"
                    Margin="0,0,0,12"
                    Padding="8" />

            <Border x:Name="ManualSelectionBorder"
                    Visibility="{Binding Visibility, ElementName=ManualSelectionScrollViewer}"
                    Background="#050505"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    MaxHeight="230"
                    ClipToBounds="True">

                <ScrollViewer x:Name="ManualSelectionScrollViewer"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              PreviewMouseWheel="OnManualScroll">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PopupScrollBar}" />
                    </ScrollViewer.Resources>

                    <ItemsControl x:Name="GroupsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <DockPanel Margin="0,0,0,6"
                                               LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    Margin="8,0,0,0">
                                            <Button Content="Select"
                                                    Tag="{Binding Name}"
                                                    Padding="7,2"
                                                    Margin="0,0,5,0"
                                                    Click="OnSelectGroupClicked" />

                                            <Button Content="Clear"
                                                    Tag="{Binding Name}"
                                                    Padding="7,2"
                                                    Click="OnClearGroupClicked" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Cases}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsTrainerSelected, Mode=TwoWay}"
                                                          Foreground="White"
                                                          Margin="8,2,0,2"
                                                          Checked="OnSelectionChanged"
                                                          Unchecked="OnSelectionChanged"
                                                          Style="{StaticResource CleanCheckBox}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
