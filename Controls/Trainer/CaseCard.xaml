<UserControl x:Class="CubeForge.Controls.CaseCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="InlineAlgorithmPickerButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#0D0D0D" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#151515" />
                                <Setter Property="BorderBrush" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineAlgorithmOptionButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#151515" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KnownCaseCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Outer"
                                Width="26"
                                Height="26"
                                CornerRadius="13"
                                Background="#151515"
                                BorderBrush="#333333"
                                BorderThickness="1.5">
                            <TextBlock x:Name="CheckText"
                                       Text="✓"
                                       Foreground="Transparent"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#143D0A" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#39FF14" />
                                <Setter TargetName="CheckText" Property="Foreground" Value="White" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="#0D0D0D"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            Padding="10"
            Margin="0,0,0,10"
            Cursor="Hand"
            MouseLeftButtonUp="OnCardClicked">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="72"
                    Height="72"
                    Background="#0A0A0A"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="5"
                    VerticalAlignment="Top">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0">

                <TextBlock Text="{Binding Name}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,36,0" />

                <TextBlock Text="{Binding Group}"
                           Foreground="#AFAFAF"
                           FontSize="12"
                           Margin="0,2,36,6" />

                <Button x:Name="AlgorithmHeaderButton"
                        Style="{StaticResource InlineAlgorithmPickerButton}"
                        Click="OnAlgorithmHeaderClicked">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding SelectedAlgorithmMoves}"
                                   Foreground="#E5E5E5"
                                   FontSize="12"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedAlgorithmMoves}" />

                        <TextBlock x:Name="AlgorithmArrowTextBlock"
                                   Grid.Column="1"
                                   Text="▾"
                                   Foreground="#AFAFAF"
                                   FontSize="10"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <primitives:Popup x:Name="AlgorithmOptionsPopup"
                                  PlacementTarget="{Binding ElementName=AlgorithmHeaderButton}"
                                  Placement="Bottom"
                                  AllowsTransparency="True"
                                  StaysOpen="False"
                                  PopupAnimation="Fade"
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                  Closed="OnAlgMenuClosed">
                    <Border Background="#0D0D0D"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="4"
                            Margin="0,4,0,0"
                            Width="{Binding ActualWidth, ElementName=AlgorithmHeaderButton}">
                        <ItemsControl ItemsSource="{Binding Algorithms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource InlineAlgorithmOptionButton}"
                                            Click="OnAlgOptionClicked">
                                        <TextBlock Text="{Binding Moves}"
                                                   Foreground="#E5E5E5"
                                                   FontSize="12"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Moves}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </primitives:Popup>
            </StackPanel>

            <CheckBox Grid.Column="1"
                      IsChecked="{Binding IsKnown, Mode=TwoWay}"
                      Style="{StaticResource KnownCaseCheckBox}"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Right"
                      Margin="0,0,0,0"
                      Click="OnKnownClicked" />
        </Grid>
    </Border>
</UserControl>
