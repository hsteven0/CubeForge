<UserControl x:Class="CubeForge.Controls.ScramblePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CubeForge.Controls"
             Background="Transparent">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Button x:Name="SelectedCasesButton"
                    Content="No cases selected"
                    Click="OnSelectedCases"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Padding="12,6"
                    HorizontalAlignment="Left">

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#111111"/>
                        <Setter Property="Foreground" Value="#39FF14"/>
                        <Setter Property="BorderThickness" Value="1"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#171717"/>
                                <Setter Property="BorderBrush" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#2ED10B"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#111111"/>
                                <Setter Property="BorderBrush" Value="#111111"/>
                                <Setter Property="Foreground" Value="#24A809"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Popup x:Name="SelectedCasesPopup"
                   PlacementTarget="{Binding ElementName=SelectedCasesButton}"
                   Placement="Top"
                   HorizontalOffset="121"
                   VerticalOffset="-8"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#0D0D0D"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Width="390"
                        MaxHeight="520">
                    <controls:CaseSelectionPopup x:Name="CaseSelectionPopupControl" SelectionChanged="OnSelectionChanged" />
                </Border>
            </Popup>
        </Grid>

        <TextBlock Text="Scramble"
                   Foreground="#AFAFAF"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PreviousScrambleButton"
                    Grid.Column="0"
                    Content="Prev"
                    Click="OnPreviousScramble"
                    MinWidth="56"
                    Height="54"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Margin="0,0,8,0"
                    Padding="8,0" />

            <Border Grid.Column="1"
                    Background="#121212"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    MinHeight="54">
                <TextBlock x:Name="ScrambleTextBlock"
                           Text="Press Next to generate a trainer scramble."
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Button x:Name="NextScrambleButton"
                    Grid.Column="2"
                    Content="Next"
                    Click="OnNextScramble"
                    MinWidth="56"
                    Height="54"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Margin="8,0,0,0"
                    Padding="8,0" />
        </Grid>

        <TextBlock Text="Hold Space to arm the timer, then release to start."
                   Foreground="#AFAFAF"
                   FontSize="12"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ApplyScrambleButton"
                    Grid.Column="0"
                    Content="Apply"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnApplyScramble"
                    Margin="0,0,8,0"
                    Padding="12,6" />

            <Button x:Name="ResetScrambleButton"
                    Grid.Column="1"
                    Content="Reset"
                    Click="OnResetScramble"
                    Margin="0,0,8,0"
                    Padding="12,6" />

            <Button x:Name="HintButton"
                    Grid.Column="2"
                    Content="Hint"
                    Click="OnHintClicked"
                    Margin="0,0,8,0"
                    Padding="12,6" />

            <Border Grid.Column="3"
                    Background="#121212"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,7"
                    MinHeight="36">
                <TextBlock x:Name="HintTextBlock"
                           Text="Hint hidden."
                           Foreground="White"
                           FontSize="15"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
