<UserControl x:Class="CubeForge.Controls.CubeControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="InstantMoveCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border Background="#0D0D0D"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="IconBox"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#7F1D1D"
                                        Margin="0,0,8,0">
                                    <TextBlock x:Name="IconText"
                                               Text="✕"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconBox" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="IconText" Property="Text" Value="✓" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrientationComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="160" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CleanComboBoxItem}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- Orientation overlay -->
        <Border Background="#CC0D0D0D"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="14,14,0,0">
            <StackPanel Width="160">
                <TextBlock Text="Orientation"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <TextBlock Text="Top Color"
                           Foreground="#AFAFAF"
                           FontSize="11"
                           Margin="0,0,0,3" />

                <ComboBox x:Name="TopColorSelectorComboBox"
                          Foreground="White"
                          SelectedIndex="0"
                          SelectionChanged="OnCubeChanged"
                          Margin="0,0,0,8"
                          Style="{StaticResource OrientationComboBox}" >
                    <ComboBoxItem Content="White" />
                    <ComboBoxItem Content="Yellow" />
                    <ComboBoxItem Content="Red" />
                    <ComboBoxItem Content="Orange" />
                    <ComboBoxItem Content="Blue" />
                    <ComboBoxItem Content="Green" />
                </ComboBox>

                <TextBlock Text="Front Color"
                           Foreground="#AFAFAF"
                           FontSize="11"
                           Margin="0,0,0,3" />

                <ComboBox x:Name="FrontColorSelectorComboBox"
                          Foreground="White"
                          SelectedIndex="2"
                          SelectionChanged="OnCubeChanged"
                          Margin="0,0,0,8"
                          Style="{StaticResource OrientationComboBox}" >
                    <ComboBoxItem Content="White" />
                    <ComboBoxItem Content="Yellow" />
                    <ComboBoxItem Content="Red" />
                    <ComboBoxItem Content="Orange" />
                    <ComboBoxItem Content="Blue" />
                    <ComboBoxItem Content="Green" />
                </ComboBox>

                <TextBlock Text="Display Mode"
                           Foreground="#AFAFAF"
                           FontSize="11"
                           Margin="0,0,0,3" />

                <ComboBox x:Name="DisplayModeSelectorComboBox"
                          Foreground="White"
                          SelectedIndex="0"
                          SelectionChanged="OnCubeChanged"
                          Margin="0,0,0,8"
                          Style="{StaticResource OrientationComboBox}" >
                    <ComboBoxItem Content="Full Color" />
                    <ComboBoxItem Content="OLL Trainer" />
                    <ComboBoxItem Content="PLL Trainer" />
                    <ComboBoxItem Content="F2L Trainer" />
                    <ComboBoxItem Content="Cross Trainer" />
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Animation speed overlay -->
        <Border Background="#CC0D0D0D"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,14,0">
            <StackPanel Width="190">
                <TextBlock Text="Move Playback"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <Slider x:Name="MoveAnimationSpeedSlider"
                        Minimum="60"
                        Maximum="600"
                        Value="260"
                        TickFrequency="20"
                        IsSnapToTickEnabled="False"
                        ValueChanged="OnSpeedChanged" />

                <Grid Margin="0,4,0,10">
                    <TextBlock Text="Slow"
                               Foreground="#AFAFAF"
                               FontSize="11"
                               HorizontalAlignment="Left" />

                    <TextBlock Text="Fast"
                               Foreground="#AFAFAF"
                               FontSize="11"
                               HorizontalAlignment="Right" />
                </Grid>

                <CheckBox x:Name="InstantMoveToggleCheckBox"
                          Content="Instant"
                          Style="{StaticResource InstantMoveCheckBoxStyle}"
                          Checked="OnInstantChanged"
                          Unchecked="OnInstantChanged" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
