<UserControl x:Class="CubeForge.Controls.CaseBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CubeForge.Controls"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#555555"
                                CornerRadius="4"
                                Opacity="0.75" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent"
                              Width="8">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  IsTabStop="False"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  IsTabStop="False"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainerLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0"
                  PreviewMouseWheel="OnCaseScroll">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}" />
        </ScrollViewer.Resources>

        <StackPanel>
            <TextBlock x:Name="CaseBrowserHeaderTextBlock"
                       Text="OLL Trainer"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"
                       Foreground="White" />

            <TextBlock x:Name="CaseBrowserDescriptionTextBlock"
                       Text="Browse OLL cases by group. Algorithm mode lets you study each case, step through moves, and see how the pieces change on the cube."
                       Foreground="#AFAFAF"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <Border Background="#050505"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="Search Case"
                               Style="{StaticResource TrainerLabel}" />

                    <TextBox x:Name="CaseSearchTextBox"
                             TextChanged="OnSearchChanged"
                             Foreground="White"
                             Background="#0D0D0D"
                             BorderBrush="#2A2A2A"
                             Padding="8"
                             Margin="0,0,0,10" />

                    <Border x:Name="SlotSelectorBorder"
                            Visibility="Collapsed"
                            Margin="0,2,0,0">
                        <StackPanel>
                            <TextBlock Text="Algorithm Choice"
                                       Style="{StaticResource TrainerLabel}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <TextBlock Text="Slot:"
                                           Foreground="#AFAFAF"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />

                                <Button x:Name="SlotFrButton"
                                        Content="FR"
                                        Tag="FR"
                                        Click="OnSlotClicked"
                                        Padding="12,4"
                                        Margin="0,0,6,0" />

                                <Button x:Name="SlotFlButton"
                                        Content="FL"
                                        Tag="FL"
                                        Click="OnSlotClicked"
                                        Padding="12,4"
                                        Margin="0,0,6,0" />

                                <Button x:Name="SlotBlButton"
                                        Content="BL"
                                        Tag="BL"
                                        Click="OnSlotClicked"
                                        Padding="12,4"
                                        Margin="0,0,6,0" />

                                <Button x:Name="SlotBrButton"
                                        Content="BR"
                                        Tag="BR"
                                        Click="OnSlotClicked"
                                        Padding="12,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding FilteredGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:AnimatedExpander Header="{Binding Name}"
                                                   IsExpanded="True"
                                                   Margin="0,0,0,12">
                            <controls:AnimatedExpander.ExpanderContent>
                                <ItemsControl ItemsSource="{Binding Cases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CaseCard CaseSelected="OnCaseSelected"
                                                                      AlgorithmSelected="OnAlgorithmSelected"
                                                                      KnownStateChanged="OnKnownChanged" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </controls:AnimatedExpander.ExpanderContent>
                        </controls:AnimatedExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
