<UserControl x:Class="CubeForge.Views.PLLTrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf"
             xmlns:controls="clr-namespace:CubeForge.Controls"
             
             Background="#050505">

    <UserControl.Resources>

        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#555555" CornerRadius="4" Opacity="0.75" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsTabStop="False" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsTabStop="False" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainerTextCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#0A0A0A" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="StatsCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#050505" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="TrainerLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="StatsLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#AFAFAF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StatsValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="PllCaseCardButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#0D0D0D" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="KnownCaseCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Outer"
                                Width="26"
                                Height="26"
                                CornerRadius="13"
                                Background="#151515"
                                BorderBrush="#333333"
                                BorderThickness="1.5">
                            <TextBlock x:Name="CheckText"
                                       Text="✓"
                                       Foreground="Transparent"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#143D0A" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#39FF14" />
                                <Setter TargetName="CheckText" Property="Foreground" Value="White" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#39FF14" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    <Style x:Key="InlineAlgorithmPickerButton" TargetType="Button">
            <Setter Property="Background" Value="#0D0D0D" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#151515" />
                                <Setter Property="BorderBrush" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineAlgorithmOptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#151515" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    
    </UserControl.Resources>

    <Grid Background="#050505">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Border Grid.Column="0" Background="#050505" Padding="8">
            <Grid Margin="-10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cube viewport -->
                <Border Grid.Row="0"
                        Background="#0D0D0D"
                        BorderBrush="#151515"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="8">
                    <Grid>
                        <hx:HelixViewport3D x:Name="ViewPort"
                                            Background="#151515"
                                            ShowViewCube="False"
                                            ShowCoordinateSystem="False"
                                            ShowFrameRate="False"
                                            IsManipulationEnabled="False"
                                            ZoomExtentsWhenLoaded="False"
                                            PreviewMouseDown="OnCubeMouseDown"
                                            PreviewMouseMove="OnCubeMouseMove"
                                            PreviewMouseUp="OnCubeMouseUp"
                                            PreviewMouseWheel="OnCubeMouseWheel"
                                            TouchDown="OnCubeTouchDown"
                                            TouchMove="OnCubeTouchMove"
                                            TouchUp="OnCubeTouchUp">
                            <hx:HelixViewport3D.Camera>
                                <PerspectiveCamera Position="8,8,8"
                                                   LookDirection="-8,-8,-8"
                                                   UpDirection="0,1,0" />
                            </hx:HelixViewport3D.Camera>

                            <hx:SunLight />

                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <DirectionalLight Color="#BBBBBB" Direction="-1,-1,-1" />
                                        <DirectionalLight Color="#BBBBBB" Direction="1,1,1" />
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                        </hx:HelixViewport3D>

                        <!-- Shared cube controls overlay -->
                        <controls:CubeControlPanel x:Name="CubeControlPanel"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch" />
                    </Grid>
                </Border>

                <!-- Bottom mode pane -->
                <Border Grid.Row="1"
                        Background="#0D0D0D"
                        BorderBrush="#151515"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Shared image slot -->
                        <Border x:Name="AlgorithmCaseImageBorder"
                                Grid.Column="0"
                                Width="120"
                                Height="120"
                                Background="#0A0A0A"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8"
                                Margin="0,0,14,0">
                            <Image x:Name="SelectedCaseImage" Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <controls:ModeToggle x:Name="ModeToggle" Margin="0,0,0,12" />

                            <!-- Algorithm mode -->
                            <controls:AlgorithmPlaybackPanel x:Name="AlgorithmPlaybackPanel" />

                            <!-- Trainer mode -->
                            <controls:ScramblePanel x:Name="ScramblePanel" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT SIDE -->
        <Border Grid.Column="1" Background="#141414" Padding="16">
            <Grid>
                <!-- Algorithm mode right pane.
                     Use Grid, not StackPanel, so CaseBrowser receives a constrained height and can show its scrollbar. -->
                <Grid x:Name="RightPaneCaseBrowser">
                    <controls:CaseBrowser x:Name="CaseBrowser"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />

                    <!-- Hidden legacy bridge controls used by older PLL code-behind methods during migration. -->
                    <TextBox x:Name="SearchCaseTextBox"
                             Visibility="Collapsed"
                             TextChanged="OnCaseSearchChanged" />
</Grid>

                <!-- Trainer mode right pane -->
                <Grid x:Name="RightPaneTrainerStats"
                      Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnScrollWheel">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}" />
                        </ScrollViewer.Resources>

                        <controls:SessionPanel x:Name="SessionPanel" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
