<UserControl x:Class="CubeForge.Views.CrossTrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hx="http://helix-toolkit.org/wpf"
             xmlns:controls="clr-namespace:CubeForge.Controls"
             Background="#050505">

    <UserControl.Resources>
        <Style x:Key="ModernScrollBarThumb"
               TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#555555"
                                CornerRadius="4"
                                Opacity="0.75" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBar"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent"
                              Width="8">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  IsTabStop="False"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  IsTabStop="False"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainerTextCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#0D0D0D" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="BottomPaneCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#171717" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="TrainerLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="MutedText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#AFAFAF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SmallStatCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#050505" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="InstantToggleCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border Background="#0D0D0D"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="IconBox"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="#7F1D1D"
                                        Margin="0,0,8,0">
                                    <TextBlock x:Name="IconText"
                                               Text="✕"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconBox" Property="Background" Value="#143D0A" />
                                <Setter TargetName="IconText" Property="Text" Value="✓" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="ChipBorder"
                                Background="#050505"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,6">
                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#143C0C" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#39FF14" />
                                <Setter Property="Foreground" Value="#D7FFC8" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ToggleBorder"
                                Background="#050505"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True" />

                                <Path Grid.Column="1"
                                      x:Name="Arrow"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="#AFAFAF"
                                      Width="8"
                                      Height="4"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#555555" />
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#0D0D0D" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#39FF14" />
                                <Setter TargetName="Arrow" Property="Fill" Value="#39FF14" />
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4" CenterY="2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanComboBox"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="310" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CleanComboBoxItem}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

    </UserControl.Resources>

    <Grid Background="#050505">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Border Grid.Column="0" Background="#050505" Padding="8">
            <Grid Margin="-10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 3D viewport -->
                <Border Grid.Row="0"
                        Background="#0D0D0D"
                        BorderBrush="#151515"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="8">
            <Grid>
                <hx:HelixViewport3D x:Name="ViewPort"
                                    Background="#151515"
                                    ShowViewCube="False"
                                    ShowCoordinateSystem="False"
                                    ShowFrameRate="False"
                                    IsManipulationEnabled="False"
                                    ZoomExtentsWhenLoaded="False"
                                    PreviewMouseDown="OnCubeMouseDown"
                                    PreviewMouseMove="OnCubeMouseMove"
                                    PreviewMouseUp="OnCubeMouseUp"
                                    PreviewMouseWheel="OnCubeMouseWheel"
                                    TouchDown="OnCubeTouchDown"
                                    TouchMove="OnCubeTouchMove"
                                    TouchUp="OnCubeTouchUp">

                    <hx:HelixViewport3D.Camera>
                        <PerspectiveCamera Position="8,8,8"
                                           LookDirection="-8,-8,-8"
                                           UpDirection="0,1,0" />
                    </hx:HelixViewport3D.Camera>

                    <hx:SunLight />

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <DirectionalLight Color="#BBBBBB" Direction="-1,-1,-1" />
                                <DirectionalLight Color="#BBBBBB" Direction="1,1,1" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                </hx:HelixViewport3D>

                <controls:CubeControlPanel x:Name="CubeControlPanel" />
            </Grid>
        </Border>

                <!-- Bottom pane -->
                <Border Grid.Row="1"
                        Background="#0D0D0D"
                        BorderBrush="#151515"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,10,0,0"
                        Height="260">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <!-- Scramble + primary controls -->
                <Border Grid.Column="0"
                        Style="{StaticResource BottomPaneCard}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Scramble"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Left" />

                            <TextBlock x:Name="CurrentTargetSummaryTextBlock"
                                       Text="Target: X-Cross"
                                       Foreground="#AFAFAF"
                                       FontSize="12"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <Border Background="#121212"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                MinHeight="70">
                            <TextBlock x:Name="ScrambleTextBlock"
                                       Text="Generate a scramble to begin."
                                       TextWrapping="Wrap"
                                       FontSize="15"
                                       Foreground="White" />
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="GenerateScrambleButton"
                                    Grid.Column="0"
                                    Content="Generate"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,6,0" Click="OnGenerateScramble" />

                            <Button x:Name="ApplyScrambleButton"
                                    Grid.Column="1"
                                    Content="Apply"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="6,0,6,0" Click="OnApplyScramble" />

                            <Button x:Name="ResetCubeButton"
                                    Grid.Column="2"
                                    Content="Reset"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="6,0,0,0" Click="OnResetCube" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Solution + hints -->
                <Border Grid.Column="1"
                        Style="{StaticResource BottomPaneCard}"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Solution"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Left" />

                           
                        </DockPanel>

                        <Border Background="#121212"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                MinHeight="86">
                            <Grid>
                                <Button x:Name="RevealSolutionButton"
                                        Content="Reveal Solution"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Padding="18,8" Click="OnRevealSolution" />

                                                            <TextBlock x:Name="SolutionTextBlock"
                                           Text=""
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Foreground="White"
                                           Visibility="Collapsed" />
                                                        </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ApplySolutionButton"
                                    Grid.Column="0"
                                    Content="Apply All"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,6,0" Click="OnApplySolution" />

                            <Button x:Name="PreviousSolutionButton"
                                    Grid.Column="1"
                                    Content="Prev"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="6,0,6,0" Click="OnPreviousSolution" />

                            <Button x:Name="NextSolutionButton"
                                    Grid.Column="2"
                                    Content="Next"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="6,0,0,0" Click="OnNextSolution" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BottomPaneCard}">
                    <StackPanel>
                        <TextBlock Text="Hints"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

                        <Border Background="#121212"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Planning Hint" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="HintStageTextBlock"
                                           Text="No hint revealed"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="NextHintButton"
                Content="Next Hint"
                Click="OnNextHint"
                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <TextBlock x:Name="HintStatusTextBlock"
           Text=""
           Foreground="#AFAFAF"
           FontSize="12"
           TextWrapping="Wrap"
           Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT SIDE -->
        <Border Grid.Column="1" Background="#141414" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource ModernScrollBar}" />
                </ScrollViewer.Resources>

                <StackPanel>
                    <TextBlock Text="Cross Trainer"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"
                               Foreground="White" />

                    <TextBlock Text="Configure the target, difficulty, and generation style."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#AFAFAF"
                               Margin="0,0,0,16" />

                    <controls:AnimatedExpander x:Name="SettingsExpander"
                                               Header="Trainer Settings"
                                               IsExpanded="True">
                        <controls:AnimatedExpander.ExpanderContent>
                            <StackPanel>
                                <TextBlock Text="Training Type" Style="{StaticResource TrainerLabel}" />

                                <ComboBox x:Name="TrainingTypeComboBox"
                                          Foreground="White"
                                          SelectedIndex="1"
                                          Margin="0,0,0,12" 
                                          Style="{StaticResource CleanComboBox}">
                                    <ComboBoxItem Content="Cross" />
                                    <ComboBoxItem Content="X-Cross" />
                                    <ComboBoxItem Content="XX-Cross" />
                                </ComboBox>

                                <TextBlock Text="Generation Mode" Style="{StaticResource TrainerLabel}" />
                                <ComboBox x:Name="GenerationModeComboBox"
                                          Foreground="White"
                                          SelectedIndex="0"
                                          Margin="0,0,0,12" Style="{StaticResource CleanComboBox}">
                                    <ComboBoxItem Content="Guaranteed solution" />
                                    <ComboBoxItem Content="Random scramble" />
                                </ComboBox>

                                <TextBlock Text="Difficulty" Style="{StaticResource TrainerLabel}" />
                                <ComboBox x:Name="DifficultyComboBox"
                                          Foreground="White"
                                          SelectedIndex="1"
                                          Margin="0,0,0,12" Style="{StaticResource CleanComboBox}">
                                    <ComboBoxItem Content="Easy" />
                                    <ComboBoxItem Content="Medium" />
                                    <ComboBoxItem Content="Hard" />
                                    <ComboBoxItem Content="Custom" />
                                </ComboBox>


                                <TextBlock x:Name="TargetSlotsHelpTextBlock"
                                           Text="Target slots appear only when the selected mode needs them."
                                           Foreground="#AFAFAF"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <StackPanel x:Name="TargetSlotsPanel">
                                    <TextBlock x:Name="TargetSlot1Label"
                                               Text="Target Slot #1"
                                               Style="{StaticResource TrainerLabel}" />
                                    <ComboBox x:Name="TargetSlot1ComboBox"
                                              Foreground="White"
                                              SelectedIndex="4"
                                              Margin="0,0,0,12" Style="{StaticResource CleanComboBox}">
                                        <ComboBoxItem Content="Random" />
                                        <ComboBoxItem Content="Front Right" />
                                        <ComboBoxItem Content="Front Left" />
                                        <ComboBoxItem Content="Back Left" />
                                        <ComboBoxItem Content="Back Right" />
                                    </ComboBox>

                                    <TextBlock x:Name="TargetSlot2Label"
                                               Text="Target Slot #2"
                                               Style="{StaticResource TrainerLabel}" Visibility="Collapsed" />
                                    <ComboBox x:Name="TargetSlot2ComboBox"
                                              Foreground="White"
                                              SelectedIndex="0"
                                              Margin="0,0,0,12" Style="{StaticResource CleanComboBox}" Visibility="Collapsed">
                                        <ComboBoxItem Content="Random" />
                                        <ComboBoxItem Content="Front Right" />
                                        <ComboBoxItem Content="Front Left" />
                                        <ComboBoxItem Content="Back Left" />
                                        <ComboBoxItem Content="Back Right" />
                                    </ComboBox>

                                    <TextBlock x:Name="TargetSlot3Label"
                                               Text="Target Slot #3"
                                               Style="{StaticResource TrainerLabel}" Visibility="Collapsed" />
                                    <ComboBox x:Name="TargetSlot3ComboBox"
                                              Foreground="White"
                                              SelectedIndex="0"
                                              Margin="0,0,0,12" Style="{StaticResource CleanComboBox}" Visibility="Collapsed">
                                        <ComboBoxItem Content="Random" />
                                        <ComboBoxItem Content="Front Right" />
                                        <ComboBoxItem Content="Front Left" />
                                        <ComboBoxItem Content="Back Left" />
                                        <ComboBoxItem Content="Back Right" />
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Text="Max Solution Length"
                                           Style="{StaticResource TrainerLabel}" />
                                <ComboBox x:Name="SolutionLengthComboBox"
                                          Foreground="White"
                                          SelectedIndex="5"
                                          Margin="0,0,0,12" Style="{StaticResource CleanComboBox}">
                                    <ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="4" />
                                    <ComboBoxItem Content="5" />
                                    <ComboBoxItem Content="6" />
                                    <ComboBoxItem Content="7" />
                                    <ComboBoxItem Content="8" />
                                    <ComboBoxItem Content="9" />
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="11" />
                                    <ComboBoxItem Content="12" />
                                </ComboBox>
                            </StackPanel>
                        </controls:AnimatedExpander.ExpanderContent>
                    </controls:AnimatedExpander>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
